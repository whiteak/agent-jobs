{"type":"assistant","message":{"id":"msg_99d135ca725044a0b4ebb6ae","type":"message","role":"assistant","model":"Qwen3.8-Flash-Next GSQ-RCO IQ3_S","content":[{"type":"tool_use","id":"call_4a93219f9379418998b1806d","name":"Write","input":{"file_path":"/work/432hs-app/app/src/main/java/com/agent/audio432/ConvertService.kt","content":"package com.agent.audio432\n\nimport android.app.NotificationChannel\nimport android.app.NotificationManager\nimport android.app.PendingIntent\nimport android.app.Service\nimport android.content.Context\nimport android.content.Intent\nimport android.content.pm.ServiceInfo\nimport android.net.Uri\nimport android.os.Build\nimport android.os.IBinder\nimport android.os.PowerManager\nimport androidx.core.app.NotificationCompat\nimport androidx.core.app.NotificationManagerCompat\nimport androidx.core.app.ServiceCompat\nimport com.agent.audio432.media.AudioDecoder\nimport com.agent.audio432.media.AudioEncoder\nimport com.agent.audio432.media.ConversionRepository\nimport com.agent.audio432.media.Converter\nimport com.agent.audio432.media.Phase\nimport com.agent.audio432.media.Storage\nimport java.io.File\nimport kotlin.concurrent.thread\n\n/**\n * Runs decode -> pitch-shift -> encode -> save as a foreground service so\n * the conversion finishes even when the app is in the background, the\n * screen locks, or Samsung's freezer tries to freeze the process\n * (observed on a Note10+: a backgrounded viewModelScope job was frozen\n * mid-encode and the .m4a was never finalised).\n */\nclass ConvertService : Service() {\n\n    private var wakeLock: PowerManager.WakeLock? = null\n    @Volatile private var running = false\n    @Volatile private var lastPct = -1\n\n    override fun onBind(intent: Intent?): IBinder? = null\n\n    override fun onCreate() {\n        super.onCreate()\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n            val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager\n            nm.createNotificationChannel(\n                NotificationChannel(\n                    CHANNEL, getString(R.string.notif_channel),\n                    NotificationManager.IMPORTANCE_LOW\n                )\n            )\n        }\n    }\n\n    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\n        if (running) return START_NOT_STICKY\n        val inputStr = intent?.getStringExtra(EXTRA_INPUT) ?: return START_NOT_STICKY\n        val from = intent.getDoubleExtra(EXTRA_FROM, 440.0)\n        val to = intent.getDoubleExtra(EXTRA_TO, 432.0)\n        val input = Uri.parse(inputStr)\n\n        running = true\n        lastPct = -1\n        // Must be called within seconds of startForegroundService(); the\n        // notification shows even when POST_NOTIFICATIONS was denied (the\n        // conversion itself never depends on the permission).\n        ServiceCompat.startForeground(\n            this, NOTIF_ID, buildNotification(getString(R.string.notif_starting), 0, true),\n            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)\n                ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROCESSING\n            else 0\n        )\n        acquireWakeLock()\n        ConversionRepository.update {\n            it.copy(\n                phase = Phase.RUNNING, progress = 0,\n                status = getString(R.string.notif_starting),\n                inputUri = input, outputUri = null, outputName = null,\n            )\n        }\n        thread(name = \"convert\") { doConversion(input, from, to) }\n        return START_NOT_STICKY\n    }\n\n    private fun doConversion(input: Uri, fromHz: Double, toHz: Double) {\n        val tmp = File(cacheDir, \"converted.m4a\")\n        try {\n            val pcm = AudioDecoder.decode(this, input) { f ->\n                report((f * 30).toInt(), getString(R.string.status_decoding))\n            }\n            val ratio = toHz / fromHz\n            val shifted = Converter.process(pcm, ratio) { f ->\n                report(\n                    30 + (f * 40).toInt(),\n                    getString(R.string.status_shifting,\n                        ConvertViewModel.fmtHz(fromHz), ConvertViewModel.fmtHz(toHz))\n                )\n            }\n            if (tmp.exists()) tmp.delete()\n            AudioEncoder.encode(shifted, tmp) { f ->\n                report(70 + (f * 30).toInt(), getString(R.string.status_encoding))\n            }\n            val base = displayBaseName(this, input)\n            val saved = Storage.save(this, tmp, \"${base}_${ConvertViewModel.fmtHz(toHz)}hz.m4a\")\n            val where = if (saved.publicDir) \"Downloads\" else \"app folder (use Share to move it)\"\n            val msg = \"Saved to $where: ${saved.name}\"\n            ConversionRepository.update {\n                it.copy(\n                    phase = Phase.DONE, progress = 100, status = msg,\n                    inputUri = input, outputUri = saved.uri, outputName = saved.name,\n                )\n            }\n            notify(msg, 100, indeterminate = false, ongoing = false)\n        } catch (t: Throwable) {\n            // Never leave a half-written container behind.\n            try { tmp.delete() } catch (_: Exception) {\n            }\n            val msg = \"Error: ${t.message ?: t.javaClass.simpleName}\"\n            ConversionRepository.update {\n                it.copy(\n                    phase = Phase.FAILED, status = msg,\n                    inputUri = input, outputUri = null, outputName = null,\n                )\n            }\n            notify(msg, 100, indeterminate = false, ongoing = false)\n        } finally {\n            running = false\n            releaseWakeLock()\n            ServiceCompat.stopForeground(this, ServiceCompat.STOP_FOREGROUND_REMOVE)\n            stopSelf()\n        }\n    }\n\n    private fun report(pct: Int, status: String) {\n        val p = pct.coerceIn(0, 100)\n        ConversionRepository.update { it.copy(progress = p, status = status) }\n        if (p != lastPct) {\n            lastPct = p\n            notify(status, p, indeterminate = false, ongoing = true)\n        }\n    }\n\n    // ------------------------------------------------------- notification\n\n    private fun hasNotifPermission(): Boolean =\n        Build.VERSION.SDK_INT < 33 ||\n                checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) ==\n                android.content.pm.PackageManager.PERMISSION_GRANTED\n\n    private fun notify(text: String, pct: Int, indeterminate: Boolean, ongoing: Boolean) {\n        // Without POST_NOTIFICATIONS the shade shows nothing, but the\n        // startForeground notification keeps the service un-frozen anyway.\n        if (!hasNotifPermission()) return\n        try {\n            NotificationManagerCompat.from(this)\n                .notify(NOTIF_ID, buildNotification(text, pct, indeterminate, ongoing))\n        } catch (_: Exception) {\n        }\n    }\n\n    private fun buildNotification(\n        text: String, pct: Int, indeterminate: Boolean, ongoing: Boolean = true\n    ): android.app.Notification {\n        val tap = PendingIntent.getActivity(\n            this, 0,\n            Intent(this, MainActivity::class.java),\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n        return NotificationCompat.Builder(this, CHANNEL)\n            .setSmallIcon(R.drawable.ic_stat_convert)\n            .setContentTitle(getString(R.string.app_name))\n            .setContentText(text)\n            .setOngoing(ongoing)\n            .setOnlyAlertOnce(true)\n            .setProgress(100, pct, indeterminate)\n            .setContentIntent(tap)\n            .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)\n            .build()\n    }\n\n    // ---------------------------------------------------------- wake lock\n\n    private fun acquireWakeLock() {\n        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager\n        wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, WAKE_TAG).apply {\n            setReferenceCounted(false)\n            // Safety timeout so a wedged encoder can never hold the CPU forever.\n            acquire(2 * 60 * 60 * 1000L)\n        }\n    }\n\n    private fun releaseWakeLock() {\n        wakeLock?.let {\n            try {\n                if (it.isHeld) it.release()\n            } catch (_: Exception) {\n            }\n        }\n        wakeLock = null\n    }\n\n    override fun onDestroy() {\n        releaseWakeLock()\n        super.onDestroy()\n    }\n\n    private fun displayBaseName(ctx: Context, uri: Uri): String {\n        var name: String? = null\n        try {\n            ctx.contentResolver.query(uri, null, null, null, null)?.use { c ->\n                val idx = c.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME)\n                if (idx >= 0 && c.moveToFirst()) name = c.getString(idx)\n            }\n        } catch (_: Exception) {\n        }\n        return (name ?: \"audio\").substringBeforeLast('.')\n            .replace(Regex(\"[^A-Za-z0-9._ -]\"), \"_\")\n            .ifBlank { \"audio\" }\n    }\n\n    companion object {\n        const val EXTRA_INPUT = \"input\"\n        const val EXTRA_FROM = \"fromHz\"\n        const val EXTRA_TO = \"toHz\"\n        private const val CHANNEL = \"conversion\"\n        private const val NOTIF_ID = 1\n        private const val WAKE_TAG = \"audio432:conversion\"\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":68274,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"7bbac423-c721-4d38-aad7-f0828aa806c1","uuid":"ee9ed2f2-572a-453a-b926-7a336ad8cee0","timestamp":"2026-11-08T12:00:17.576Z"}
