#!/bin/bash
# Mode 2a: Claude Code driving the LOCAL Basalt model. No Anthropic traffic.
unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL=http://127.0.0.1:8080 ANTHROPIC_AUTH_TOKEN=basalt-local
M="Qwen3.8-Flash-Next GSQ-RCO IQ3_S"
export ANTHROPIC_MODEL="$M" ANTHROPIC_DEFAULT_OPUS_MODEL="$M" ANTHROPIC_DEFAULT_SONNET_MODEL="$M" ANTHROPIC_DEFAULT_HAIKU_MODEL="$M" CLAUDE_CODE_SUBAGENT_MODEL="$M"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_AUTOUPDATER=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1
export CLAUDE_CONFIG_DIR="$HOME/.claude-local" API_TIMEOUT_MS=1800000 CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072
exec claude --dangerously-skip-permissions "$@"
