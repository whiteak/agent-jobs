blicDir) \"Downloads\" else \"app folder (use Share to move it)\"","-                _state.update {","-                    it.copy(","-                        busy = false,","-                        progress = 100,","-                        status = \"Saved to $where: ${saved.name}\",","-                        outputUri = saved.uri,","-                        outputName = saved.name,","-                    )","-                }","-            } catch (t: Throwable) {","-                _state.update {","-                    it.copy(busy = false, status = \"Error: ${t.message ?: t.javaClass.simpleName}\")","-                }","-            }","-        }","+        val intent = Intent(getApplication(), ConvertService::class.java)","+            .putExtra(ConvertService.EXTRA_INPUT, input.toString())","+            .putExtra(ConvertService.EXTRA_FROM, fromHz)","+            .putExtra(ConvertService.EXTRA_TO, toHz)","+        ContextCompat.startForegroundService(getApplication(), intent)","     }"," ","     // --------------------------------------------------------------- player"]},{"oldStart":340,"oldLines":7,"newStart":340,"newLines":7,"lines":["     }"," ","     companion object {","-        /** Below this, the detected tuning is not trusted and 440 is used. */","+        /** Below this, the detected tuning is shown as a guess but 440 stays. */","         const val MIN_DETECT_CONFIDENCE = 0.35"," ","         fun fmtHz(v: Double): String ="]}],"originalFile":"package com.agent.audio432\n\nimport android.app.Application\nimport android.content.Context\nimport android.media.MediaMetadataRetriever\nimport android.media.MediaPlayer\nimport android.net.Uri\nimport android.provider.OpenableColumns\nimport androidx.lifecycle.AndroidViewModel\nimport androidx.lifecycle.viewModelScope\nimport com.agent.audio432.dsp.TuningDetector\nimport com.agent.audio432.media.AbSwitch\nimport com.agent.audio432.media.AudioDecoder\nimport com.agent.audio432.media.AudioEncoder\nimport com.agent.audio432.media.Converter\nimport com.agent.audio432.media.Storage\nimport com.agent.audio432.media.Pcm\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport kotlinx.coroutines.flow.update\nimport kotlinx.coroutines.launch\nimport java.io.File\n\nclass ConvertViewModel(application: Application) : AndroidViewModel(application) {\n\n    data class Detected(val hz: Double, val confidence: Double)\n\n    data class PlayerState(\n        val active: Boolean = false,\n        val source: AbSwitch.Source = AbSwitch.Source.CONVERTED,\n        val prepared: Boolean = false,\n        val playing: Boolean = false,\n        val positionMs: Int = 0,\n        val durationMs: Int = 0,\n    )\n\n    data class State(\n        val busy: Boolean = false,\n        val progress: Int = 0,\n        val status: String? = null,\n        val inputUri: Uri? = null,\n        val detected: Detected? = null,\n        val outputUri: Uri? = null,\n        val outputName: String? = null,\n        val player: PlayerState = PlayerState(),\n    )\n\n    private val _state = MutableStateFlow(State())\n    val state: StateFlow<State> = _state.asStateFlow()\n\n    fun setStatus(text: String) {\n        _state.update { it.copy(status = text) }\n    }\n\n    fun setInput(uri: Uri) {\n        _state.update { it.copy(inputUri = uri, detected = null) }\n    }\n\n    // ---------------------------------------------------------------- tune\n\n    /**\n     * Decodes the file, mixes to mono and estimates the actual reference\n     * pitch (see dsp/TuningDetector). The result lands in state.detected;\n     * the UI fills the From field from it (the user can still edit).\n     */\n    fun detectTuning(uri: Uri) {\n        if (_state.value.busy) return\n        _state.update { it.copy(status = \"Detecting tuning…\") }\n        viewModelScope.launch(Dispatchers.Default) {\n            val ctx = getApplication<Application>()\n            try {\n                val pcm = AudioDecoder.decode(ctx, uri) { f ->\n                    _state.update { it.copy(status = \"Detecting tuning… ${(f * 100).toInt()}%\") }\n                }\n                val mono = mixToMono(pcm)\n                val r = TuningDetector.estimate(mono, pcm.sampleRate)\n                if (r != null && r.confidence >= MIN_DETECT_CONFIDENCE) {\n                    val hz = Math.round(r.referenceHz * 10.0) / 10.0\n                    _state.update {\n                        it.copy(\n                            detected = Detected(hz, r.confidence),\n                            status = \"Detected A≈${\"%.1f\".format(hz)} Hz \" +\n                                    \"(confidence ${\"%.2f\".format(r.confidence)})\",\n                        )\n                    }\n                } else {\n                    _state.update {\n                        it.copy(\n                            detected = null,\n                            status = \"Tuning unclear\" + if (r != null)\n                                \" (confidence ${\"%.2f\".format(r.confidence)})\" else \"\" +\n                                    \" — assuming A=440 Hz\",\n                        )\n                    }\n                }\n            } catch (t: Throwable) {\n                _state.update {\n                    it.copy(\n                        detected = null,\n                        status = \"Tuning detection failed (${t.message ?: \"error\"}) — assuming A=440 Hz\",\n                    )\n                }\n            }\n        }\n    }\n\n    private fun mixToMono(pcm: Pcm): FloatArray {\n        val frames = pcm.frames\n        val ch = pcm.channelCount\n        val mono = FloatArray(frames)\n        if (ch == 1) {\n            for (i in 0 until frames) mono[i] = pcm.samples[i] / 32768f\n        } else {\n            for (i in 0 until frames) {\n                var acc = 0\n                for (c in 0 until ch) acc += pcm.samples[i * ch + c]\n                mono[i] = acc / (32768f * ch)\n            }\n        }\n        return mono\n    }\n\n    // -------------------------------------------------------------- convert\n\n    fun convert(input: Uri, fromHz: Double, toHz: Double) {\n        if (_state.value.busy) return\n        if (fromHz <= 0.0 || toHz <= 0.0 || toHz / fromHz !in 0.5..2.0) {\n            _state.update {\n                it.copy(status = \"Ratio must stay between a fifth down and up (0.5–2.0).\")\n            }\n            return\n        }\n        stopPlayback()\n        _state.update {\n            it.copy(\n                busy = true, progress = 0, status = \"Decoding…\",\n                outputUri = null, outputName = null,\n            )\n        }\n        viewModelScope.launch(Dispatchers.Default) {\n            val ctx = getApplication<Application>()\n            try {\n                val pcm = AudioDecoder.decode(ctx, input) { f ->\n                    _state.update {\n                        it.copy(progress = (f * 30).toInt(), status = \"Decoding…\")\n                    }\n                }\n                val ratio = toHz / fromHz\n                val shifted = Converter.process(pcm, ratio) { f ->\n                    _state.update {\n                        it.copy(\n                            progress = 30 + (f * 40).toInt(),\n                            status = \"Shifting pitch ${fmtHz(fromHz)} → ${fmtHz(toHz)} Hz…\",\n                        )\n                    }\n                }\n                val tmp = File(ctx.cacheDir, \"converted.m4a\")\n                AudioEncoder.encode(shifted, tmp) { f ->\n                    _state.update {\n                        it.copy(progress = 70 + (f * 30).toInt(), status = \"Encoding…\")\n                    }\n                }\n                val base = displayBaseName(ctx, input)\n                val saved = Storage.save(ctx, tmp, \"${base}_${fmtHz(toHz)}hz.m4a\")\n                val where = if (saved.publicDir) \"Downloads\" else \"app folder (use Share to move it)\"\n                _state.update {\n                    it.copy(\n                        busy = false,\n                        progress = 100,\n                        status = \"Saved to $where: ${saved.name}\",\n                        outputUri = saved.uri,\n                        outputName = saved.name,\n                    )\n                }\n            } catch (t: Throwable) {\n                _state.update {\n                    it.copy(busy = false, status = \"Error: ${t.message ?: t.javaClass.simpleName}\")\n                }\n            }\n        }\n    }\n\n    // --------------------------------------------------------------- player\n    //\n    // The MediaPlayer lives here, not in the Activity, so playback keeps\n    // running across screen rotation. It is released in onCleared(), i.e.\n    // when the app is really dismissed (rotation keeps the same ViewModel).\n\n    private var player: MediaPlayer? = null\n    private var pendingPosMs = 0\n    private var pendingStart = false\n\n    /** Load [source] into the player, resuming at [startPosMs]. */\n    fun openPlayer(source: AbSwitch.Source, startPosMs: Int = 0, startPlaying: Boolean = true) {\n        val uri = when (source) {\n            AbSwitch.Source.ORIGINAL -> _state.value.inputUri\n            AbSwitch.Source.CONVERTED -> _state.value.outputUri\n        } ?: return\n        releasePlayer()\n        pendingPosMs = startPosMs\n        pendingStart = startPlaying\n        _state.update {\n            it.copy(player = PlayerState(active = true, source = source, positionMs = startPosMs))\n        }\n        val mp = MediaPlayer()\n        player = mp\n        try {\n            mp.setDataSource(getApplication<Application>(), uri)\n        } catch (t: Throwable) {\n            releasePlayer()\n            _state.update { it.copy(status = \"Cannot play: ${t.message ?: \"error\"}\") }\n            return\n        }\n        mp.setOnPreparedListener {\n            val dur = it.duration\n            val pos = AbSwitch.handoffPosition(pendingPosMs, dur)\n            it.seekTo(pos)\n            _state.update { st ->\n                st.copy(player = st.player.copy(prepared = true, durationMs = dur, positionMs = pos))\n            }\n            if (pendingStart) {\n                it.start()\n                _state.update { st -> st.copy(player = st.player.copy(playing = true)) }\n            }\n        }\n        mp.setOnCompletionListener {\n            _state.update { st ->\n                st.copy(player = st.player.copy(playing = false, positionMs = st.player.durationMs))\n            }\n        }\n        mp.setOnErrorListener { _, _, _ ->\n            releasePlayer()\n            _state.update { it.copy(player = PlayerState(), status = \"Playback error\") }\n            true\n        }\n        mp.prepareAsync()\n    }\n\n    fun togglePlayPause() {\n        val mp = player ?: return\n        val st = _state.value.player\n        if (!st.prepared) return\n        try {\n            if (st.playing) mp.pause() else mp.start()\n            _state.update {\n                it.copy(player = it.player.copy(playing = !st.playing, positionMs = mp.currentPosition))\n            }\n        } catch (_: IllegalStateException) {\n        }\n    }\n\n    fun seekTo(ms: Int) {\n        val mp = player ?: return\n        if (!_state.value.player.prepared) return\n        try {\n            mp.seekTo(ms.coerceAtLeast(0))\n            _state.update { it.copy(player = it.player.copy(positionMs = mp.currentPosition)) }\n        } catch (_: IllegalStateException) {\n        }\n    }\n\n    /** A/B: jump to the other file at the same position, keeping play state. */\n    fun toggleAb() {\n        val st = _state.value.player\n        if (!st.active) return\n        openPlayer(AbSwitch.other(st.source), st.positionMs, st.playing)\n    }\n\n    /** UI polling tick: refresh the reported position from the player. */\n    fun tickPosition() {\n        val mp = player ?: return\n        if (!_state.value.player.prepared) return\n        try {\n            val pos = mp.currentPosition\n            _state.update { st ->\n                if (st.player.positionMs != pos) st.copy(player = st.player.copy(positionMs = pos)) else st\n            }\n        } catch (_: IllegalStateException) {\n        }\n    }\n\n    fun stopPlayback() {\n        releasePlayer()\n        _state.update { it.copy(player = PlayerState()) }\n    }\n\n    private fun releasePlayer() {\n        player?.let {\n            try {\n                it.reset()\n            } catch (_: IllegalStateException) {\n            }\n            it.release()\n        }\n        player = null\n    }\n\n    override fun onCleared() {\n        releasePlayer()\n        super.onCleared()\n    }\n\n    // ---------------------------------------------------------------- misc\n\n    fun audioInfo(ctx: Context, uri: Uri): String {\n        val retriever = MediaMetadataRetriever()\n        return try {\n            retriever.setDataSource(ctx, uri)\n            val durMs = retriever.extractMetadata(\n                MediaMetadataRetriever.METADATA_KEY_DURATION\n            )?.toLongOrNull()\n            if (durMs != null) {\n                val m = durMs / 60000\n                val s = (durMs / 1000) % 60\n                \"${m}m ${\"%02d\".format(s)}s\"\n            } else \"duration unknown\"\n        } catch (t: Throwable) {\n            \"could not read metadata\"\n        } finally {\n            try { retriever.release() } catch (_: Exception) {\n            }\n        }\n    }\n\n    private fun displayBaseName(ctx: Context, uri: Uri): String {\n        var name: String? = null\n        try {\n            ctx.contentResolver.query(uri, null, null, null, null)?.use { c ->\n                val idx = c.getColumnIndex(OpenableColumns.DISPLAY_NAME)\n                if (idx >= 0 && c.moveToFirst()) name = c.getString(idx)\n            }\n        } catch (_: Exception) {\n        }\n        val cleaned = (name ?: \"audio\").substringBeforeLast('.')\n            .replace(Regex(\"[^A-Za-z0-9._ -]\"), \"_\")\n            .ifBlank { \"audio\" }\n        return cleaned\n    }\n\n    companion object {\n        /** Below this, the detected tuning is not trusted and 440 is used. */\n        const val MIN_DETECT_CONFIDENCE = 0.35\n\n        fun fmtHz(v: Double): String =\n            if (v % 1.0 == 0.0) v.toInt().toString() else String.format(\"%.2f\", v)\n    }\n}\n","userModified":false},"tool_result_meta":[{"id":"call_70e7038fad374762bf3dc5bd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
