{"type":"assistant","message":{"id":"msg_42a73d59763d440aa7dffb70","type":"message","role":"assistant","model":"Qwen3.8-Flash-Next GSQ-RCO IQ3_S","content":[{"type":"tool_use","id":"call_e9fab3cdf0cb4d35b958ca43","name":"Write","input":{"file_path":"/work/432hs-app/app/src/main/java/com/agent/audio432/dsp/TuningDetector.kt","content":"package com.agent.audio432.dsp\n\nimport kotlin.math.PI\nimport kotlin.math.abs\nimport kotlin.math.atan2\nimport kotlin.math.ceil\nimport kotlin.math.cos\nimport kotlin.math.floor\nimport kotlin.math.hypot\nimport kotlin.math.ln\nimport kotlin.math.log2\nimport kotlin.math.max\nimport kotlin.math.min\nimport kotlin.math.round\nimport kotlin.math.sin\n\n/**\n * Estimates the reference pitch of a recording by measuring how far its\n * spectral peaks sit from the 12-tone equal-tempered grid anchored at\n * A=440 Hz — the same idea as librosa.effects.estimate_tuning, with two\n * robustness changes from on-device feedback (a hip-hop track with heavy\n * 808 bass scored only 0.18 confidence):\n *\n *  - peaks are only counted between [minHz] and [maxHz] (default\n *    200-2000 Hz): sub-200 Hz bass and kick content carries little\n *    reliable tuning information and can even sit close to grid points\n *    by accident,\n *  - a peak must **persist** across at least [minSustain] consecutive\n *    FFT frames (frequency within ~3 bins) to vote. One-off transients —\n *    drum hits, plosives — appear in a single frame and are ignored;\n *    sustained notes keep voting.\n *\n * Steps (all pure Kotlin/JVM so it can be unit-tested):\n *  - analyze several windows spread over the song (default 5 windows,\n *    ~12 s each), mono float input,\n *  - Hann-windowed FFTs of [fftSize] samples (default 8192), hop n/2,\n *  - local maxima above a relative magnitude threshold, refined by\n *    parabolic interpolation in log-magnitude, filtered as above,\n *  - each surviving peak's deviation from the nearest equal-tempered\n *    semitone in cents (-50..+50) contributes weight * exp(i*2*pi*cents/100),\n *  - the magnitude-weighted circular mean of those angles gives the mean\n *    tuning deviation; |sum| / sum(weights) is the confidence.\n *\n * Reference frequency = 440 * 2^(cents/1200).\n */\nobject TuningDetector {\n\n    data class Result(val cents: Double, val confidence: Double) {\n        val referenceHz: Double get() = 440.0 * Math.pow(2.0, cents / 1200.0)\n    }\n\n    /** A peak of one frame, matched forward across frames. */\n    private class Peak(val freq: Double, val mag: Double, var sustain: Int)\n\n    fun estimate(\n        x: FloatArray,\n        sampleRate: Int,\n        fftSize: Int = 8192,\n        windowCount: Int = 5,\n        windowSeconds: Double = 12.0,\n        minHz: Double = 200.0,\n        maxHz: Double = 2000.0,\n        thresholdFrac: Double = 0.02,\n        minSustain: Int = 3,\n    ): Result? {\n        require(fftSize and (fftSize - 1) == 0 && fftSize >= 256) { \"fftSize must be a power of two >= 256\" }\n        val n = fftSize\n        val half = n / 2\n        val binHz = sampleRate.toDouble() / n\n        val kMin = max(1, ceil(minHz / binHz).toInt())\n        val kMax = min(half - 2, floor(maxHz / binHz).toInt())\n        if (kMax <= kMin + 1) return null\n\n        val winLen = min((sampleRate * windowSeconds).toInt(), x.size)\n        if (winLen < n) return null\n        // Spread windows over the song, skipping the first/last 5%.\n        val margin = (x.size * 0.05).toInt()\n        val span = max(0, x.size - 2 * margin - winLen)\n\n        // Two bins of slack for the parabolic estimate + small vibrato.\n        val matchTol = 3.0 * binHz\n\n        val fft = Fft(n)\n        val window = DoubleArray(n) { 0.5 - 0.5 * cos(2.0 * PI * it / n) }\n        val re = FloatArray(n)\n        val im = FloatArray(n)\n        val mag = DoubleArray(half + 1)\n\n        var sumS = 0.0\n        var sumC = 0.0\n        var sumW = 0.0\n        var framesUsed = 0\n\n        for (w in 0 until max(1, windowCount)) {\n            val start = margin + if (windowCount > 1) span * w / (windowCount - 1) else 0\n            val last = min(start + winLen, x.size) - n\n            var pos = start\n            // Persistence tracking restarts at each analysis window: frames\n            // from different windows are not consecutive in time.\n            val prev = ArrayList<Peak>()\n            val cur = ArrayList<Peak>()\n            while (pos <= last) {\n                for (i in 0 until n) {\n                    re[i] = (x[pos + i] * window[i]).toFloat()\n                    im[i] = 0f\n                }\n                fft.forward(re, im)\n                var frameMax = 0.0\n                for (k in kMin..kMax) {\n                    val m = hypot(re[k].toDouble(), im[k].toDouble())\n                    mag[k] = m\n                    if (m > frameMax) frameMax = m\n                }\n                val thr = frameMax * thresholdFrac\n                cur.clear()\n                for (k in kMin..kMax) {\n                    val m = mag[k]\n                    if (m < thr) continue\n                    if (m <= mag[k - 1] || m <= mag[k + 1]) continue\n                    // Parabolic interpolation in log-magnitude.\n                    val a = ln(max(mag[k - 1], 1e-12))\n                    val b = ln(m)\n                    val c = ln(max(mag[k + 1], 1e-12))\n                    val denom = a - 2.0 * b + c\n                    val delta = if (denom != 0.0) (0.5 * (a - c) / denom).coerceIn(-1.0, 1.0) else 0.0\n                    val f = (k + delta) * binHz\n                    if (f < minHz || f > maxHz) continue\n                    cur.add(Peak(f, m, 1))\n                }\n                for (pk in cur) {\n                    // Match to the same pitch in the previous frame.\n                    var best: Peak? = null\n                    var bestD = matchTol\n                    for (pp in prev) {\n                        val d = abs(pk.freq - pp.freq)\n                        if (d <= bestD) { bestD = d; best = pp }\n                    }\n                    if (best != null) pk.sustain = best.sustain + 1\n                    // Only sustained peaks vote; weight favours the longer-\n                    // lived ones a bit (sqrt keeps big transients down).\n                    if (pk.sustain >= minSustain) {\n                        val semitones = 12.0 * log2(pk.freq / 440.0)\n                        val cents = (semitones - round(semitones)) * 100.0\n                        val ang = 2.0 * PI * cents / 100.0\n                        val wgt = pk.mag * Math.sqrt(pk.sustain.toDouble())\n                        sumS += wgt * sin(ang)\n                        sumC += wgt * cos(ang)\n                        sumW += wgt\n                    }\n                }\n                prev.clear()\n                for (pk in cur) prev.add(Peak(pk.freq, pk.mag, pk.sustain))\n                framesUsed++\n                pos += n / 2\n            }\n        }\n        if (sumW <= 0.0 || framesUsed == 0) return null\n        val meanCents = atan2(sumS, sumC) * 100.0 / (2.0 * PI)\n        val confidence = hypot(sumS, sumC) / sumW\n        return Result(meanCents, confidence)\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":73084,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"7bbac423-c721-4d38-aad7-f0828aa806c1","uuid":"6d21d331-726c-4e53-ad92-91d9635ccc1a","timestamp":"2026-11-08T12:00:52.301Z"}
