            MediaCodecInfo.CodecProfileLevel.AACObjectLC\n            )\n            setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, 1 shl 16)\n        }\n\n        val codec = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_AUDIO_AAC)\n        var muxer: MediaMuxer? = null\n        try {\n            codec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)\n            codec.start()\n            muxer = MediaMuxer(outFile.absolutePath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)\n\n            val info = MediaCodec.BufferInfo()\n            val bytesPerFrame = 2 * pcm.channelCount\n            val totalFrames = pcm.frames\n            var frameIndex = 0\n            var inputDone = false\n            var muxerStarted = false\n            var trackIndex = -1\n\n            while (true) {\n                if (!inputDone) {\n                    val inIdx = codec.dequeueInputBuffer(10_000)\n                    if (inIdx >= 0) {\n                        val inBuf = codec.getInputBuffer(inIdx)!!\n                        val remainFrames = totalFrames - frameIndex\n                        if (remainFrames <= 0) {\n                            codec.queueInputBuffer(\n                                inIdx, 0, 0, 0,\n                                MediaCodec.BUFFER_FLAG_END_OF_STREAM\n                            )\n                            inputDone = true\n                        } else {\n                            val chunkFrames = minOf(remainFrames, 4096)\n                            inBuf.order(ByteOrder.LITTLE_ENDIAN)\n                            inBuf.clear()\n                            for (i in 0 until chunkFrames * pcm.channelCount) {\n                                inBuf.putShort(pcm.samples[frameIndex * pcm.channelCount + i])\n                            }\n                            val size = chunkFrames * bytesPerFrame\n                            val ptsUs = frameIndex * 1_000_000L / pcm.sampleRate\n                            codec.queueInputBuffer(inIdx, 0, size, ptsUs, 0)\n                            frameIndex += chunkFrames\n                        }\n                    }\n                }\n\n                val outIdx = codec.dequeueOutputBuffer(info, 10_000)\n                if (outIdx == MediaCodec.INFO_TRY_AGAIN_LATER && inputDone) {\n                    // drain loop continues until EOS below\n                }\n                if (outIdx == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {\n                    if (!muxerStarted) {\n                        trackIndex = muxer.addTrack(codec.outputFormat)\n                        muxer.start()\n                        muxerStarted = true\n                    }\n                } else if (outIdx >= 0) {\n                    val outBuf = codec.getOutputBuffer(outIdx)!!\n                    if (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG != 0) {\n                        info.size = 0\n                    }\n                    if (info.size > 0 && muxerStarted) {\n                        outBuf.position(info.offset)\n                        outBuf.limit(info.offset + info.size)\n                        muxer.writeSampleData(trackIndex, outBuf, info)\n                    }\n                    codec.releaseOutputBuffer(outIdx, false)\n                    if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) break\n                }\n                progress((frameIndex.toDouble() / maxOf(1, totalFrames)).coerceIn(0.0, 1.0))\n            }\n            progress(1.0)\n        } finally {\n            try {\n                muxer?.release() // finalizes the file; throws if never started\n            } catch (_: IllegalStateException) {\n            }\n            codec.release()\n        }\n    }\n}\n","numLines":103,"startLine":1,"totalLines":103}},"tool_result_meta":[{"id":"call_e19bf7f719324466afb0e0a7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
