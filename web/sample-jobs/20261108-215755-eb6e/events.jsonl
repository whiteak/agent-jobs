ound(this, ServiceCompat.STOP_FOREGROUND_REMOVE)\n            stopSelf()\n        }\n    }\n\n    private fun report(pct: Int, status: String) {\n        val p = pct.coerceIn(0, 100)\n        ConversionRepository.update { it.copy(progress = p, status = status) }\n        if (p != lastPct) {\n            lastPct = p\n            notify(status, p, indeterminate = false, ongoing = true)\n        }\n    }\n\n    // ------------------------------------------------------- notification\n\n    private fun hasNotifPermission(): Boolean =\n        Build.VERSION.SDK_INT < 33 ||\n                checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) ==\n                android.content.pm.PackageManager.PERMISSION_GRANTED\n\n    private fun notify(text: String, pct: Int, indeterminate: Boolean, ongoing: Boolean) {\n        // Without POST_NOTIFICATIONS the shade shows nothing, but the\n        // startForeground notification keeps the service un-frozen anyway.\n        if (!hasNotifPermission()) return\n        try {\n            NotificationManagerCompat.from(this)\n                .notify(NOTIF_ID, buildNotification(text, pct, indeterminate, ongoing))\n        } catch (_: Exception) {\n        }\n    }\n\n    private fun buildNotification(\n        text: String, pct: Int, indeterminate: Boolean, ongoing: Boolean = true\n    ): android.app.Notification {\n        val tap = PendingIntent.getActivity(\n            this, 0,\n            Intent(this, MainActivity::class.java),\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n        return NotificationCompat.Builder(this, CHANNEL)\n            .setSmallIcon(R.drawable.ic_stat_convert)\n            .setContentTitle(getString(R.string.app_name))\n            .setContentText(text)\n            .setOngoing(ongoing)\n            .setOnlyAlertOnce(true)\n            .setProgress(100, pct, indeterminate)\n            .setContentIntent(tap)\n            .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)\n            .build()\n    }\n\n    // ---------------------------------------------------------- wake lock\n\n    private fun acquireWakeLock() {\n        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager\n        wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, WAKE_TAG).apply {\n            setReferenceCounted(false)\n            // Safety timeout so a wedged encoder can never hold the CPU forever.\n            acquire(2 * 60 * 60 * 1000L)\n        }\n    }\n\n    private fun releaseWakeLock() {\n        wakeLock?.let {\n            try {\n                if (it.isHeld) it.release()\n            } catch (_: Exception) {\n            }\n        }\n        wakeLock = null\n    }\n\n    override fun onDestroy() {\n        releaseWakeLock()\n        super.onDestroy()\n    }\n\n    private fun displayBaseName(ctx: Context, uri: Uri): String {\n        var name: String? = null\n        try {\n            ctx.contentResolver.query(uri, null, null, null, null)?.use { c ->\n                val idx = c.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME)\n                if (idx >= 0 && c.moveToFirst()) name = c.getString(idx)\n            }\n        } catch (_: Exception) {\n        }\n        return (name ?: \"audio\").substringBeforeLast('.')\n            .replace(Regex(\"[^A-Za-z0-9._ -]\"), \"_\")\n            .ifBlank { \"audio\" }\n    }\n\n    companion object {\n        const val EXTRA_INPUT = \"input\"\n        const val EXTRA_FROM = \"fromHz\"\n        const val EXTRA_TO = \"toHz\"\n        private const val CHANNEL = \"conversion\"\n        private const val NOTIF_ID = 1\n        private const val WAKE_TAG = \"audio432:conversion\"\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"call_4a93219f9379418998b1806d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
