sUsed++","                 pos += n / 2","             }"]}],"originalFile":"package com.agent.audio432.dsp\n\nimport kotlin.math.PI\nimport kotlin.math.atan2\nimport kotlin.math.ceil\nimport kotlin.math.cos\nimport kotlin.math.floor\nimport kotlin.math.hypot\nimport kotlin.math.ln\nimport kotlin.math.log2\nimport kotlin.math.max\nimport kotlin.math.min\nimport kotlin.math.round\nimport kotlin.math.sin\n\n/**\n * Estimates the reference pitch of a recording by measuring how far its\n * spectral peaks sit from the 12-tone equal-tempered grid anchored at\n * A=440 Hz — the same idea as librosa.effects.estimate_tuning.\n *\n * Steps (all pure Kotlin/JVM so it can be unit-tested):\n *  - analyze several windows spread over the song (default 5 windows,\n *    ~12 s each), mono float input,\n *  - Hann-windowed FFTs of [fftSize] samples (default 8192), hop n/2,\n *  - spectral peaks (local maxima) between [minHz] and [maxHz] above a\n *    relative magnitude threshold, refined by parabolic interpolation in\n *    log-magnitude,\n *  - each peak's deviation from the nearest equal-tempered semitone in\n *    cents (-50..+50) contributes weight * exp(i*2*pi*cents/100),\n *  - the magnitude-weighted circular mean of those angles gives the mean\n *    tuning deviation; |sum| / sum(weights) is the confidence.\n *\n * Reference frequency = 440 * 2^(cents/1200).\n */\nobject TuningDetector {\n\n    data class Result(val cents: Double, val confidence: Double) {\n        val referenceHz: Double get() = 440.0 * Math.pow(2.0, cents / 1200.0)\n    }\n\n    fun estimate(\n        x: FloatArray,\n        sampleRate: Int,\n        fftSize: Int = 8192,\n        windowCount: Int = 5,\n        windowSeconds: Double = 12.0,\n        minHz: Double = 80.0,\n        maxHz: Double = 2000.0,\n        thresholdFrac: Double = 0.02,\n    ): Result? {\n        require(fftSize and (fftSize - 1) == 0 && fftSize >= 256) { \"fftSize must be a power of two >= 256\" }\n        val n = fftSize\n        val half = n / 2\n        val binHz = sampleRate.toDouble() / n\n        val kMin = max(1, ceil(minHz / binHz).toInt())\n        val kMax = min(half - 2, floor(maxHz / binHz).toInt())\n        if (kMax <= kMin + 1) return null\n\n        val winLen = min((sampleRate * windowSeconds).toInt(), x.size)\n        if (winLen < n) return null\n        // Spread windows over the song, skipping the first/last 5%.\n        val margin = (x.size * 0.05).toInt()\n        val span = max(0, x.size - 2 * margin - winLen)\n\n        val fft = Fft(n)\n        val window = DoubleArray(n) { 0.5 - 0.5 * cos(2.0 * PI * it / n) }\n        val re = FloatArray(n)\n        val im = FloatArray(n)\n        val mag = DoubleArray(half + 1)\n\n        var sumS = 0.0\n        var sumC = 0.0\n        var sumW = 0.0\n        var framesUsed = 0\n\n        for (w in 0 until max(1, windowCount)) {\n            val start = margin + if (windowCount > 1) span * w / (windowCount - 1) else 0\n            val last = min(start + winLen, x.size) - n\n            var pos = start\n            while (pos <= last) {\n                for (i in 0 until n) {\n                    re[i] = (x[pos + i] * window[i]).toFloat()\n                    im[i] = 0f\n                }\n                fft.forward(re, im)\n                var frameMax = 0.0\n                for (k in kMin..kMax) {\n                    val m = hypot(re[k].toDouble(), im[k].toDouble())\n                    mag[k] = m\n                    if (m > frameMax) frameMax = m\n                }\n                val thr = frameMax * thresholdFrac\n                for (k in kMin..kMax) {\n                    val m = mag[k]\n                    if (m < thr) continue\n                    if (m <= mag[k - 1] || m <= mag[k + 1]) continue\n                    // Parabolic interpolation in log-magnitude.\n                    val a = ln(max(mag[k - 1], 1e-12))\n                    val b = ln(m)\n                    val c = ln(max(mag[k + 1], 1e-12))\n                    val denom = a - 2.0 * b + c\n                    val delta = if (denom != 0.0) (0.5 * (a - c) / denom).coerceIn(-1.0, 1.0) else 0.0\n                    val f = (k + delta) * binHz\n                    if (f < minHz || f > maxHz) continue\n                    val semitones = 12.0 * log2(f / 440.0)\n                    val cents = (semitones - round(semitones)) * 100.0\n                    val ang = 2.0 * PI * cents / 100.0\n                    sumS += m * sin(ang)\n                    sumC += m * cos(ang)\n                    sumW += m\n                }\n                framesUsed++\n                pos += n / 2\n            }\n        }\n        if (sumW <= 0.0 || framesUsed == 0) return null\n        val meanCents = atan2(sumS, sumC) * 100.0 / (2.0 * PI)\n        val confidence = hypot(sumS, sumC) / sumW\n        return Result(meanCents, confidence)\n    }\n}\n","userModified":false},"tool_result_meta":[{"id":"call_e9fab3cdf0cb4d35b958ca43","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
